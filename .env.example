# --- Local LLM (Cloud Run) ---
LLM_BASE_URL=https://ollama-xxxxxxxxxx-an.a.run.app
LLM_API_TYPE=ollama            # ollama | openai (vLLM / llama.cpp / Ollama の /v1 互換API)
LLM_MODEL=gemma3:4b
LLM_USE_ID_TOKEN=true          # LLM の Cloud Run が IAM 認証必須 (--no-allow-unauthenticated) の場合
# LLM_API_KEY=                 # OpenAI 互換サーバで API キーが必要な場合
# LLM_TIMEOUT=300
# SYSTEM_PROMPT=あなたは親切で有能な日本語アシスタントです。
# MAX_HISTORY_MESSAGES=40

# --- 履歴の保存先 (Firestore ネイティブモード) ---
FIRESTORE_PROJECT=your-project-id   # 未指定時は実行環境の既定プロジェクト
FIRESTORE_DATABASE=(default)
# ローカルで Firestore エミュレータを使う場合:
# FIRESTORE_EMULATOR_HOST=localhost:8085

# --- 認証 ---
AUTH_MODE=local                # local (ユーザ名/パスワード) | iap (Identity-Aware Proxy)
ALLOW_SIGNUP=true
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false            # HTTPS 環境 (Cloud Run) では true
